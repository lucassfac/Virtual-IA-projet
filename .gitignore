# --- NEURAL FORGE : STOCKAGE DYNAMIQUE ---
# Ignore le contenu des dossiers de stockage pour ne pas push les données utilisateurs/modèles
storage/models/*
!storage/models/.gitkeep
!storage/models/README.md

storage/data/*
!storage/data/.gitkeep

storage/images/*
!storage/images/.gitkeep

storage/logs/*
!storage/logs/.gitkeep

# Ignore les bases de données vectorielles locales (RAG) si créées à l'avenir
storage/chroma_db/
storage/vector_store/

